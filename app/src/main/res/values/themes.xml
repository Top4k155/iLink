<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ILink" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/accent_fg</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/fg</item>
        <item name="colorBackgroundFloating">@color/card</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_muted</item>
    </style>

    <style name="Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/card_border</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="Accent" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="TextTitle">
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextBold">
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextMuted">
        <item name="android:textColor">@color/fg_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
